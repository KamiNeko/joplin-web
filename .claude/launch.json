{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "dev"],
      "port": 5173
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "server", "run", "dev"],
      "port": 3001
    },
    {
      "name": "demo-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "server", "run", "demo"],
      "env": { "PORT": "3101", "MOCK_JOPLIN_PORT": "22300" },
      "port": 3101
    },
    {
      "name": "demo-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "env": { "API_PROXY_TARGET": "http://localhost:3101" },
      "port": 5174
    }
  ]
}
