# Joplin Web configuration for Docker Compose. Copy to .env and adjust.
# For local development (npm run dev) use server/.env.example instead.

# Base URL of your Joplin Server (required)
JOPLIN_SERVER_URL=https://notes.example.com

# Port published on the host (optional, default: 3001). The container always listens on 3001.
# HOST_PORT=3001

# Address you open Joplin Web at, when it runs behind a reverse proxy (optional)
# PUBLIC_URL=https://notes-web.example.com

# Reverse proxies in front of Joplin Web: hop count or proxy addresses/subnets (optional, default: false)
# TRUST_PROXY=1

# Allow images from any https:// URL in notes (optional, default: false; remote hosts see who reads the note)
# ALLOW_REMOTE_IMAGES=false

# Secure flag of the session cookie: auto, true or false (optional, default: auto)
# COOKIE_SECURE=auto

# Allowed origins for API calls, comma-separated (optional). Only needed when the web UI is
# served from a different origin than the API; the default single-container setup doesn't need it.
# CORS_ORIGIN=https://notes-web.example.com

# How long the note cache is used before it is re-synced with Joplin Server, in ms (optional)
# CACHE_TTL_MS=30000

# How long a validated session is trusted before it is checked again, in ms (optional)
# AUTH_CACHE_TTL_MS=300000
