# Joplin Web configuration for Docker Compose. Copy to .env and adjust.
# For local development (npm run dev) use server/.env.example instead.

# Base URL of your Joplin Server (required)
JOPLIN_SERVER_URL=https://notes.example.com

# Port published on the host (optional, default: 3001). The container always listens on 3001.
# HOST_PORT=3001

# Address you open Joplin Web at, when it runs behind a reverse proxy (optional)
# PUBLIC_URL=https://notes-web.example.com

# Reverse proxies in front of Joplin Web: hop count or proxy addresses/subnets (optional, default: false)
# TRUST_PROXY=1

# Allow images from any https:// URL in notes (optional, default: false; remote hosts see who reads the note)
# ALLOW_REMOTE_IMAGES=false

# Secure flag of the session cookie: auto, true or false (optional, default: auto)
# COOKIE_SECURE=auto

# Allowed origins for API calls, comma-separated (optional). Only needed when the web UI is
# served from a different origin than the API; the default single-container setup doesn't need it.
# CORS_ORIGIN=https://notes-web.example.com

# API requests per client address and 15 minutes (optional, default: 1000)
# RATE_LIMIT_MAX=1000

# How long the note cache is used before it is re-synced with Joplin Server, in ms (optional)
# CACHE_TTL_MS=30000

# How long a validated session is trusted before it is checked again, in ms (optional)
# AUTH_CACHE_TTL_MS=300000

# Optional AI features: Auto-organize, Ask My Notes, Note Assist, and Voice Transcription
# (disabled unless both AI_BASE_URL and AI_MODEL are set).
# When triggered by a user, note titles, link-stripped text (~2000-6000 chars), attachment OCR,
# and notebook/tag names for the relevant scope are sent to AI_BASE_URL.
# AI_BASE_URL=http://127.0.0.1:18317/v1
# AI_API_KEY=
# AI_MODEL=deepseek-flash
# AI_TRANSCRIBE_MODEL=gemini-3.8-flash
# AI_CONCURRENCY=4

# Optional instant OCR bridge (deploy/joplin-ocr-bridge.py) for immediate OCR on attachment upload
# OCR_SERVICE_URL=http://127.0.0.1:18319
# OCR_SERVICE_SECRET=
# OCR_INLINE_WAIT_MS=4000

# Directory for persistent per-user state such as 2FA enrollments, workspace preferences (shortcuts,
# recent reads, scratchpad), and Auto-organize jobs (required for 2FA and REQUIRE_2FA)
# CACHE_DIR=/data/cache

# Require every user to pass a second factor (users with none enrolled must enroll at login)
# REQUIRE_2FA=false

# Optional headless Email-to-Note webhook (POST /api/webhooks/email). Disabled unless secret and
# service Joplin account credentials are set. Send secret in X-Webhook-Secret or Bearer header.
# EMAIL_INGEST_WEBHOOK_SECRET=
# EMAIL_INGEST_JOPLIN_EMAIL=
# EMAIL_INGEST_JOPLIN_PASSWORD=
# EMAIL_INGEST_NOTEBOOK_ID=
