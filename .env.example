# Joplin Server URL (required)
JOPLIN_SERVER_URL=https://your-joplin-server.example.com

# Server port (optional, default: 3001)
PORT=3001

# CORS origin for development (optional, default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Address you open Joplin Web at, when it runs behind a reverse proxy (optional)
# PUBLIC_URL=https://notes-web.example.com

# Reverse proxies in front of Joplin Web: hop count or proxy addresses/subnets (optional, default: false)
# TRUST_PROXY=1

# Allow images from any https:// URL in notes (optional, default: false; remote hosts see who reads the note)
# ALLOW_REMOTE_IMAGES=false

# Secure flag of the session cookie: auto, true or false (optional, default: auto)
# COOKIE_SECURE=auto

# Node environment
NODE_ENV=development
