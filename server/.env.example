# Server Configuration
PORT=3001
NODE_ENV=development

# Joplin Server (required; base URL of your Joplin Server)
JOPLIN_SERVER_URL=https://notes.example.com

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Reverse proxy / HTTPS (optional, see README)
# PUBLIC_URL=https://notes-web.example.com
# TRUST_PROXY=1
# COOKIE_SECURE=auto

# Allow images from any https:// URL in notes (default: false)
# ALLOW_REMOTE_IMAGES=false

# Cache Configuration (in milliseconds)
CACHE_TTL_MS=30000
AUTH_CACHE_TTL_MS=300000
