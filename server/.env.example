# Local development configuration (npm --prefix server run dev). Copy to server/.env.
# For Docker deployments use the .env.example in the repository root.

# Port the API listens on (default: 3001)
PORT=3001
NODE_ENV=development

# Joplin Server (required; base URL of a Joplin Server with test data, never your real notes)
JOPLIN_SERVER_URL=https://notes.example.com

# Allowed origins for API calls, comma-separated (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Reverse proxy / HTTPS (optional, see README)
# PUBLIC_URL=https://notes-web.example.com
# TRUST_PROXY=1
# COOKIE_SECURE=auto

# Allow images from any https:// URL in notes (default: false)
# ALLOW_REMOTE_IMAGES=false

# Cache configuration (in milliseconds)
CACHE_TTL_MS=30000
AUTH_CACHE_TTL_MS=300000

# Build metadata, normally injected at image build time (defaults: dev / unset)
# APP_VERSION=dev
# GIT_SHA=
